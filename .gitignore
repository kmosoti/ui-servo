.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.env

# Owner's scratch HTML. The golden ancestor copies it was drawn from are
# preserved under direction/references/golden/, so nothing here is load-bearing.
# Anchored: a bare `experiments/` would match at any depth, the same mistake
# `evidence/` made below.
/experiments/

# U6: rust build artifacts for the site skeleton
site/target/

# V1: the static export. Generated by `cargo run --bin export` from the same
# page functions the server uses, so committing it would be committing a second
# copy of the site that can only ever be more stale than the first.
site/dist/

# Working evidence is transient. The demo round is not: a reader who cannot
# inspect the gate rejection, the blind prompts and the verdicts has to take
# the README's word for all three.
#
# The negation is load-bearing and was briefly lost. A bare `evidence/` matches
# at any depth, so it also swallowed `demo/round-4/evidence/`, and the demo went
# on claiming its verdicts were committed while they were untracked — the exact
# failure the demo exists to rule out.
evidence/
!demo/**/evidence/
!demo/**/evidence/**

# Store bookkeeping, not evidence.
.lock
.seq

# Generated deploy artefacts: contain real keys and addresses.
cloud-init.generated.sh
ci_deploy
ci_deploy.pub
dist/
