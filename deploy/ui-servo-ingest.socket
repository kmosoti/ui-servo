# /etc/systemd/system/ui-servo-ingest.socket
#
# The ingest is a demo telemetry sink on a 512 MB box, and it is idle almost
# all the time. Left running it holds ~80 MB — 15% of the droplet — to do
# nothing. Socket activation makes that 0: systemd holds the port, and the
# service only exists while beacons are arriving.
#
# Measured: inactive and unmetered at rest, ~1.3 s to answer the first beacon
# after idle, ~19 ms warm, back to nothing 20 s after the last request.
[Unit]
Description=ui-servo beacon ingest socket

[Socket]
ListenStream=127.0.0.1:8111

[Install]
WantedBy=sockets.target
